{
  "manifest_version": 3,
  "name": "MiNiGeMi Sidebar",
  "version": "1.0",
  "permissions": ["sidePanel", "tabs", "scripting", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "action": {
    "default_title": "Open MiNiGeMi"
  }
}